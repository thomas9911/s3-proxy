# S3 Proxy configuration. Variables use S3_PROXY__ and nested fields use __.
# The binary reads environment variables directly; load this file with your shell,
# Docker Compose, or another dotenv-compatible launcher.

# HTTP server and generated external URLs.
S3_PROXY__SERVER_HOST=0.0.0.0:3000
S3_PROXY__EXTERNAL_SERVER_HOST=http://127.0.0.1:3000
# 256 MiB. Single-request uploads are currently buffered in memory.
S3_PROXY__MAX_REQUEST_BODY_BYTES=268435456

# Metadata backend: sqlite, redis, or postgres.
S3_PROXY__METADATA_BACKEND=sqlite
S3_PROXY__SQLITE__URL=sqlite::memory:
# S3_PROXY__REDIS__URL=redis://127.0.0.1:6379
# S3_PROXY__POSTGRES__URL=postgres://postgres:password@127.0.0.1:5432/s3proxy

# Initial S3 administrator. Both values are required to seed the credential.
S3_PROXY__ADMIN__ACCESS_KEY=admin
S3_PROXY__ADMIN__SECRET_KEY=change-this-s3-admin-secret

# Management dashboard Basic authentication. Set both values to enable /admin.
S3_PROXY__MANAGEMENT__USERNAME=admin
S3_PROXY__MANAGEMENT__PASSWORD=change-this-management-password

# Optional global per-principal limits. Leave unset for no limit.
# S3_PROXY__QUOTAS__MAX_STORAGE_BYTES=10737418240
# S3_PROXY__QUOTAS__MAX_REQUESTS_PER_MINUTE=1000

# OpenDAL storage provider. Enable one provider block below.
S3_PROXY__OPENDAL_PROVIDER=memory

# memory: no additional options.

# fs:
# S3_PROXY__OPENDAL_PROVIDER=fs
# S3_PROXY__OPENDAL__ROOT=./data

# s3 (for MinIO or another S3-compatible service):
# S3_PROXY__OPENDAL_PROVIDER=s3
# S3_PROXY__OPENDAL__BUCKET=proxy-storage
# S3_PROXY__OPENDAL__ENDPOINT=http://127.0.0.1:9000
# S3_PROXY__OPENDAL__REGION=us-east-1
# S3_PROXY__OPENDAL__ACCESS_KEY_ID=minioadmin
# S3_PROXY__OPENDAL__SECRET_ACCESS_KEY=minioadmin
# S3_PROXY__OPENDAL__ENABLE_VIRTUAL_HOST_STYLE=false

# sled:
# S3_PROXY__OPENDAL_PROVIDER=sled
# S3_PROXY__OPENDAL__DATADIR=./data/sled
